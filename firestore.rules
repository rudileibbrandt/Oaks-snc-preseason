rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Team membership (join code) ----------
    // Signing in is open to anyone, but only team members can read or write team data. A sign-in
    // becomes a member by entering the team's join code (members/{uid}). Existing users were
    // made members when the code was introduced (Nov 2026).
    function isMember() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // A coach is a member whose profile has role Coach. Members created at sign-up have no
    // profileId: their profile is saved under their uid.
    function isCoach() {
      let m = get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
      return get(/databases/$(database)/documents/roster/$(m.get('profileId', request.auth.uid))).data.role == 'Coach';
    }

    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // Join (or re-join) with the current code. The code itself is never readable before joining.
      allow create, update: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.code == get(/databases/$(database)/documents/config/team).data.joinCode &&
                    request.resource.data.keys().hasOnly(['code', 'joinedAt']);
      allow list, delete: if false;
    }

    match /config/team {
      allow get: if isMember();
      allow update: if isMember() && isCoach() &&
                    request.resource.data.joinCode is string && request.resource.data.joinCode.size() >= 4 &&
                    request.resource.data.keys().hasOnly(['joinCode', 'updatedAt', 'updatedBy']);
      allow create, delete, list: if false;
    }

    // Roster: members read/update (stat board, admin role changes, merge). Before joining, a
    // sign-in may only look up its own profile, which is how the app tells a new user from a
    // returning one.
    match /roster/{playerId} {
      allow read: if isMember() ||
                  (request.auth != null && (resource.data.userId == request.auth.uid ||
                                            request.auth.uid in resource.data.get('linkedUserIds', [])));
      // Users can only create profiles with their own auth UID, and only as a Player:
      // coach access is turned on afterwards by an existing coach (Admin -> Users).
      allow create: if isMember() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.role == 'Player';
      // Any member can update (needed for admin role changes, account merging)
      allow update: if isMember();
      // Deletes are not allowed from the app
      allow delete: if false;
    }
    
    // A profile belongs to its own sign-in, plus any sign-in whose old profile was merged into it
    // (linkedUserIds). Without the link, a merged player's workouts were refused.
    function ownsProfile(playerId) {
      let p = get(/databases/$(database)/documents/roster/$(playerId)).data;
      return p.userId == request.auth.uid || request.auth.uid in p.get('linkedUserIds', []);
    }

    // Logs: Any member can read (for stat board), but only create/update their own
    match /logs/{logId} {
      // Any member can read (for stat board)
      allow read: if isMember();
      // Users can only create/update logs for their own playerId
      // Verify the playerId belongs to the user by checking the roster document
      allow create: if isMember() &&
                    request.resource.data.playerId != null &&
                    exists(/databases/$(database)/documents/roster/$(request.resource.data.playerId)) &&
                    ownsProfile(request.resource.data.playerId);
      allow update: if isMember() &&
                    resource.data.playerId != null &&
                    exists(/databases/$(database)/documents/roster/$(resource.data.playerId)) &&
                    ownsProfile(resource.data.playerId);
      // Deletes are not allowed from the app
      allow delete: if false;
    }

    // Roster classes: graduation year per roster player, keyed by normalized name
    match /rosterClasses/{nameKey} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }

    // Team calendar events (practices, matches). Coach-only editing is enforced in the app.
    // Deletes allowed so a cancelled event can be removed.
    match /events/{eventId} {
      allow read, create, update, delete: if isMember();
    }

    // S&C standards testing: testing days and each player's results on them.
    // Coach-only entry is enforced in the app (roster roles are editable, so rules can't check them).
    match /testSessions/{sessionId} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }
    match /testResults/{resultId} {
      allow read, create, update: if isMember();
      allow delete: if false;
    }

    // Height and weight entries, keyed by roster name like test results. Add-only: a correction
    // is a newer entry, so nothing in the history can be changed or removed from the app.
    // Who may enter for whom (self vs coach) is enforced in the app, as for testing.
    match /bodyMeasurements/{entryId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.enteredByUserId == request.auth.uid
        && request.resource.data.nameKey is string
        && request.resource.data.date is string
        && (request.resource.data.enteredByRole == 'Player' || request.resource.data.enteredByRole == 'Coach')
        && (request.resource.data.get('heightIn', null) != null || request.resource.data.get('weightLb', null) != null)
        && (request.resource.data.get('heightIn', null) == null
            || (request.resource.data.heightIn is number && request.resource.data.heightIn >= 48 && request.resource.data.heightIn <= 90))
        && (request.resource.data.get('weightLb', null) == null
            || (request.resource.data.weightLb is number && request.resource.data.weightLb >= 80 && request.resource.data.weightLb <= 400));
      allow update, delete: if false;
    }

    // Injuries: Anyone authenticated can read, coaches can create/update
    match /injuries/{injuryId} {
      allow read: if isMember();
      allow create, update: if isMember();
      allow delete: if false;
    }

    // Player Ratings: Anyone authenticated can read, create, and update (true 360 review)
    match /ratings/{ratingId} {
      allow read: if isMember();
      // Users can only create ratings with their own auth UID
      allow create: if isMember() &&
                    request.resource.data.raterUserId == request.auth.uid;
      // Users can update their own ratings; any authenticated user can update ratings field only (migration)
      allow update: if isMember();
      // Users can delete their own ratings, coaches can delete any (app-level restriction)
      allow delete: if isMember();
    }

    // Rating History: Anyone authenticated can read, create, update ratings field (migration), delete
    match /ratingHistory/{historyId} {
      allow read: if isMember();
      // Users can only create history entries with their own auth UID
      allow create: if isMember() &&
                    request.resource.data.raterUserId == request.auth.uid;
      // Allow update for migration (ratings field only)
      allow update: if isMember();
      allow delete: if isMember();
    }
  }
}

