rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Roster: Anyone authenticated can read/update (for stat board, admin role changes, merge)
    match /roster/{playerId} {
      allow read: if request.auth != null;
      // Users can only create profiles with their own auth UID
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      // Any authenticated user can update (needed for admin role changes, account merging)
      allow update: if request.auth != null;
      // Deletes are not allowed from the app
      allow delete: if false;
    }
    
    // Logs: Anyone authenticated can read (for stat board), but only create/update their own
    match /logs/{logId} {
      // Anyone authenticated can read (for stat board)
      allow read: if request.auth != null;
      // Users can only create/update logs for their own playerId
      // Verify the playerId belongs to the user by checking the roster document
      allow create: if request.auth != null &&
                    request.resource.data.playerId != null &&
                    exists(/databases/$(database)/documents/roster/$(request.resource.data.playerId)) &&
                    get(/databases/$(database)/documents/roster/$(request.resource.data.playerId)).data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                    resource.data.playerId != null &&
                    exists(/databases/$(database)/documents/roster/$(resource.data.playerId)) &&
                    get(/databases/$(database)/documents/roster/$(resource.data.playerId)).data.userId == request.auth.uid;
      // Deletes are not allowed from the app
      allow delete: if false;
    }

    // Roster classes: graduation year per roster player, keyed by normalized name
    match /rosterClasses/{nameKey} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Injuries: Anyone authenticated can read, coaches can create/update
    match /injuries/{injuryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Player Ratings: Anyone authenticated can read, create, and update (true 360 review)
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      // Users can only create ratings with their own auth UID
      allow create: if request.auth != null &&
                    request.resource.data.raterUserId == request.auth.uid;
      // Users can update their own ratings; any authenticated user can update ratings field only (migration)
      allow update: if request.auth != null;
      // Users can delete their own ratings, coaches can delete any (app-level restriction)
      allow delete: if request.auth != null;
    }

    // Rating History: Anyone authenticated can read, create, update ratings field (migration), delete
    match /ratingHistory/{historyId} {
      allow read: if request.auth != null;
      // Users can only create history entries with their own auth UID
      allow create: if request.auth != null &&
                    request.resource.data.raterUserId == request.auth.uid;
      // Allow update for migration (ratings field only)
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}

